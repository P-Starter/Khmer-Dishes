{"id": "khm-0559", "slug": "lemongrass-marinated-grill-frog", "name": {"km": "អាំងគ្រឿងកង្កែប", "romanized": "Aing Kreung Kong Kep", "en": "Lemongrass-Marinated Grill Frog"}, "category": "grilled", "subcategory": "aing-kreung", "cuisine": "Khmer", "description": "Charcoal-grilled frog — lemongrass-marinated grill.", "descriptionKm": "អាំងជាមួយគ្រឿង — ប្រឡាក់ឱ្យឈ្ងុយ ហើយអាំងលើភ្លើងធ្យូង។", "image": "images/dishes/lemongrass-marinated-grill-frog.jpg", "imageFamily": "grilled-aing-aing-kreung", "tags": ["grilled", "aing", "aing-kreung", "frog", "meat"], "dietary": [], "spiceLevel": 1, "difficulty": "easy", "servings": 4, "time": {"prepMinutes": 30, "cookMinutes": 23, "totalMinutes": 53}, "kroeung": ["lemongrass", "galangal", "fresh turmeric", "kaffir lime leaves", "garlic", "shallots", "dried red chili"], "equipment": ["charcoal grill"], "equipmentKm": ["ភ្លើងធ្យូង"], "ingredients": [{"group": "main", "item": "frog", "quantity": 600, "unit": "g", "notes": "cleaned and jointed", "itemKm": "កង្កែប"}, {"group": "kroeung", "item": "lemongrass", "quantity": 3, "unit": "stalks", "notes": "tender part, finely sliced", "itemKm": "ស្លឹកគ្រៃ", "notesKm": "យកផ្នែកទន់ ហាន់ស្ដើង"}, {"group": "kroeung", "item": "galangal", "quantity": 1, "unit": "thumb", "notes": "peeled and sliced", "itemKm": "រំដេង", "notesKm": "ចេញសំបក ហើយហាន់"}, {"group": "kroeung", "item": "fresh turmeric", "quantity": 1, "unit": "tsp", "notes": "or 1 thumb fresh", "itemKm": "រមៀតស្រស់", "notesKm": "ឬ ១មេដៃស្រស់"}, {"group": "kroeung", "item": "kaffir lime leaves", "quantity": 4, "unit": "leaves", "notes": "de-stemmed", "itemKm": "ស្លឹកក្រូចសើច", "notesKm": "ដកដើម"}, {"group": "kroeung", "item": "garlic", "quantity": 4, "unit": "cloves", "itemKm": "ខ្ទឹមស"}, {"group": "kroeung", "item": "shallots", "quantity": 3, "unit": "whole", "itemKm": "ខ្ទឹមក្រហម"}, {"group": "kroeung", "item": "dried red chili", "quantity": 2, "unit": "whole", "notes": "soaked, optional for heat", "itemKm": "ម្ទេសក្រហមស្ងួត", "notesKm": "