{"id": "khm-1053", "slug": "pumpkin-custard-sankhya-lapov", "name": {"km": "សង់ខ្យាល្ពៅ", "romanized": "Sankhya Lapov", "en": "Pumpkin Custard (Sankhya Lapov)"}, "category": "dessert", "subcategory": "street-food", "cuisine": "Khmer", "description": "Coconut-egg custard steamed inside a whole kabocha pumpkin.", "descriptionKm": "សង់ខ្យាល្ពៅ — សង់ខ្យាចំហុយក្នុងផ្លែល្ពៅ។", "image": "images/dishes/pumpkin-custard-sankhya-lapov.jpg", "imageFamily": "snack-street-food-pumpkin-custard-sankhya-lapov", "tags": ["snack", "street-food", "pumpkin-custard-sankhya-lapov"], "dietary": [], "spiceLevel": 0, "difficulty": "medium", "servings": 2, "time": {"prepMinutes": 31, "cookMinutes": 60, "totalMinutes": 91}, "kroeung": [], "equipment": [], "ingredients": [{"group": "main", "item": "kabocha pumpkin", "itemKm": "ល្ពៅ"}, {"group": "main", "item": "eggs"}, {"group": "main", "item": "palm sugar", "itemKm": "ស្ករត្នោត"}, {"group": "main", "item": "coconut milk", "itemKm": "ទឹកដូង"}, {"group": "main", "item": "pandan", "itemKm": "ស្លឹកតើយ"}], "instructions": [{"step": 1, "text": "Cut a lid in the pumpkin and scoop out the seeds."}, {"step": 2, "text": "Whisk eggs, palm sugar, coconut milk and pandan; strain."}, {"step": 3, "text": "Pour the custard into the pumpkin."}, {"step": 4, "text": "Steam 45–60 minutes until set; cool and slice into wedges."}]}