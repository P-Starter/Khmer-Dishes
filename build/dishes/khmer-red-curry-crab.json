m": "ម្ទេសក្រហមស្ងួត", "notesKm": "ត្រាំ (ស្ម័គ្រសម្រាប់ភាពហឹរ)"}, {"group": "kroeung", "item": "dried red chili", "quantity": 6, "unit": "whole", "notes": "soaked, for colour & heat", "itemKm": "ម្ទេសក្រហមស្ងួត", "notesKm": "ត្រាំ (សម្រាប់ពណ៌ និងភាពហឹរ)"}, {"group": "main", "item": "coconut milk", "quantity": 400, "unit": "ml", "itemKm": "ទឹកដូង"}, {"group": "garnish", "item": "coconut cream", "quantity": 4, "unit": "tbsp", "notes": "for topping", "itemKm": "ខ្ទិះដូង", "notesKm": "សម្រាប់ដាក់ពីលើ"}, {"group": "seasoning", "item": "fish sauce", "quantity": 2, "unit": "tbsp", "itemKm": "ទឹកត្រី"}, {"group": "seasoning", "item": "palm sugar", "quantity": 1, "unit": "tbsp", "itemKm": "ស្ករត្នោត"}, {"group": "veg", "item": "sweet potato", "quantity": 1, "unit": "whole", "notes": "chunks", "itemKm": "ដំឡូងជ្វា", "notesKm": "ដុំៗ"}, {"group": "veg", "item": "onion", "quantity": 1, "unit": "whole", "notes": "wedges", "itemKm": "ខ្ទឹមបារាំង", "notesKm": "ចំណិត"}, {"group": "seasoning", "item": "curry powder", "quantity": 1, "unit": "tbsp", "itemKm": "ម្សៅការី"}, {"group": "serving", "item": "baguette", "quantity": 2, "unit": "whole", "notes": "to serve", "itemKm": "នំបុ័ង", "notesKm": "សម្រាប់បរិភោគ"}], "instructions": [{"step": 1, "text": "Fry the red kroeung and curry powder in coconut cream until aromatic and the oil splits."}, {"step": 2, "text": "Add the crab (cleaned and quartered) and brown lightly."}, {"step": 3, "text": "Pour in coconut milk and enough water to cover; add sweet potato and onion."}, {"step": 4, "text": "Simmer until until the shells turn bright orange and the vegetables are tender, about 27 minutes."}, {"step": 5, "text": "Season with fish sauce and palm sugar.", "textKm": "បន្ថែមទឹកត្រី និងស្ករត្នោត។"}, {"step": 6, "text": "Serve hot with crusty baguette or fresh rice noodles (num banh chok)."}]}